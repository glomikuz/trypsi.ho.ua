## Кодування документів
AddDefaultCharset utf-8
#AddDefaultCharset koi8-u
#AddDefaultCharset windows-1251

## Постійне перенаправлення (301) з http:// на https://
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

## Сторінки, які перенесено
Redirect 301 /osvit.html /odvit_prog.html

## Файл індексного документа
#DirectoryIndex index.shtml index.html index.htm index.php

## Обробляти файли *.html як SSI
#AddHandler server-parsed .html

## Увімкнути розбір SSI-виразів у застарілому форматі
#SSILegacyExprParser on

## Дозвіл показу вмісту каталогу
#Options +Indexes

## Не записувати в access.log інформацію про файли *.gif та *.jpg
#SetEnvIf Request_URI \.gif$ access_log
#SetEnvIf Request_URI \.jpg$ access_log


AddHandler cgi-script .cgi .py
